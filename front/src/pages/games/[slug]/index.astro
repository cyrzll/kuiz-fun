---
import Layout from '../../../layouts/Layout.astro';
import GameFlowApp from '../../../components/GameFlowApp.jsx';
import dummyRoomData from '../../../data/dummyRoom.json';

export function getStaticPaths() {
  return Object.keys(dummyRoomData).map((code) => ({
    params: { slug: code }
  }));
}

const { slug } = Astro.params;
---

<Layout>
	<GameFlowApp client:load slug={slug} />
</Layout>
